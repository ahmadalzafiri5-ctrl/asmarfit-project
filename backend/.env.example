# Get a free key at https://api.data.gov/signup — takes one form, arrives by email in minutes.
USDA_API_KEY=your_usda_key_here

# Port the backend listens on
PORT=3001

# Optional: enables the in-app assistant (POST /api/assistant)
ANTHROPIC_API_KEY=

# Optional: Sofort-Nachricht an den Betreiber bei neuem Nutzer / neuem Abo / KI-Paket (siehe README "Benachrichtigungen an den Betreiber")
# Telegram: Token vom BotFather, Chat-ID aus getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# E-Mail über Resend (https://resend.com), Empfänger = Betreiber; NOTIFY_FROM optional (Standard "ASFIT <onboarding@resend.dev>")
RESEND_API_KEY=
ADMIN_EMAIL=
NOTIFY_FROM=
# Beliebiger Webhook (Slack/Discord/Zapier...), bekommt POST JSON {kind, text, fields, at}
ADMIN_NOTIFY_URL=
